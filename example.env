# opensplat (repo splatnet): OpenPak's replacement for Nintendo's SplatNet. Copy to .env; never commit .env.
# BOSS: the keys are console-dumped (BetterKeyDumper); without them the rotation cannot be read.
PN_SPLATOON_WEBSITE_BOSS_AES_KEY=
PN_SPLATOON_WEBSITE_BOSS_HMAC_KEY=
# Public name of the BOSS tasksheet host (sent as Host), and where to actually connect to it.
PN_SPLATOON_WEBSITE_BOSS_DOMAIN=https://npts.app.openpak.org
PN_SPLATOON_WEBSITE_BOSS_INTERNAL_URL=http://openpak-nn-boss:20080
PN_SPLATOON_WEBSITE_BOSS_APP_ID=rjVlM7hUXPxmYQJh
# Hours of rotation to show, and where the decrypted VSSetting is cached (keep it on a volume).
PN_SPLATOON_WEBSITE_MAX_RESPONSE=12
PN_SPLATOON_WEBSITE_FILE_CACHE_DIR=/home/node/cache
# The Splatoon title database (read-only is enough).
PN_SPLATOON_WEBSITE_POSTGRES_URI=postgres://openpak@openpak-postgres/splatoonwiiu?sslmode=disable
# nn-account (account.v2 GetUserData) and nn-friends gRPC.
PN_SPLATOON_WEBSITE_GRPC_ACCOUNT_HOST=openpak-nn-account
PN_SPLATOON_WEBSITE_GRPC_ACCOUNT_PORT=20051
PN_SPLATOON_WEBSITE_GRPC_ACCOUNT_API_KEY=
PN_SPLATOON_WEBSITE_GRPC_FRIENDS_HOST=openpak-nn-friends
PN_SPLATOON_WEBSITE_GRPC_FRIENDS_PORT=20061
PN_SPLATOON_WEBSITE_GRPC_FRIENDS_API_KEY=
# Judd's Splatfest read API (internal port; leave empty to show the game server's numbers only).
PN_SPLATOON_WEBSITE_JUDD_URL=http://openpak-judd:20141
# Player tag themes.
PN_SPLATOON_WEBSITE_LOG_FORMAT=json
PN_SPLATOON_WEBSITE_LOG_LEVEL=info
# Sign-in through openpak.org single sign-on (client "opensplat"); hidden unless all four are set.
# SSO_URL is openpak.org's website as this container reaches it; the secret is the website's
# SSO_CLIENT_OPENSPLAT_SECRET; the key signs the session cookies (32+ characters).
PN_SPLATOON_WEBSITE_PUBLIC_HOSTNAME=https://splat.openpak.org
PN_SPLATOON_WEBSITE_SSO_URL=http://openpak-website:20010
PN_SPLATOON_WEBSITE_SSO_SESSION_KEY=
SSO_CLIENT_OPENSPLAT_SECRET=
# Account erasure (openpak/prds#120): bearer key (from deploy/erase.env), the listener port (container
# network only, never routed), and the account core gRPC used to resolve the account's Wii U PIDs.
# nn-account's resolution service is reached through the GRPC_ACCOUNT_* settings above.
ACCOUNT_ERASE_KEY=
PN_SPLATOON_WEBSITE_ERASE_PORT=8081
SPLATNET_CORE_ADDR=openpak-account:7000
SPLATNET_CORE_KEY=
